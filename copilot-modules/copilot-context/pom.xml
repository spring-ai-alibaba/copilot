<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>copilot-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>copilot-context</artifactId>
    <name>Copilot Context Module</name>
    <description>上下文管理模块 - 管理会话状态、历史记录、上下文切换和持久化</description>

    <dependencies>

        <!-- 通用模块依赖 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>copilot-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>copilot-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>copilot-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>copilot-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring AI（已移除：copilot-context 不再依赖 spring-ai / spring-ai-alibaba，agent 框架换用 agentscope） -->

        <!-- MCP Java SDK：供 McpClientManager 管理外部 MCP Server 连接（STDIO/SSE），原由 spring-ai-starter-mcp-client 传递，现直接声明 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp.version}</version>
        </dependency>

        <!-- AgentScope 2.0 - 替代 spring-ai-alibaba-agent-framework -->
        <!-- HarnessAgent（自带 workspace/filesystem 工具/compaction）+ 事件流 streamEvents + Middleware -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- AgentScope OpenAI 兼容模型扩展（接 DashScope compatible-mode / DeepSeek / SiliconFlow） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>

        <!-- AgentScope Anthropic 模型扩展（Claude 原生 Messages API /v1/messages） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-anthropic</artifactId>
        </dependency>

        <!-- AgentScope AG-UI 协议适配器（AgentEvent → AG-UI 事件） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-agui</artifactId>
        </dependency>

        <!-- AgentScope MySQL AgentStateStore（会话状态持久化，阶段2 用） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-mysql</artifactId>
        </dependency>

        <!-- Diff Utils -->
        <dependency>
            <groupId>io.github.java-diff-utils</groupId>
            <artifactId>java-diff-utils</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
